# Base URL of the Polaris API (polaris-be). Must be reachable from the device.
# Android emulator: http://10.0.2.2:3000
# Physical device:  http://<LAN-IP-of-your-machine>:3000, or the staging HTTPS URL
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Sentry DSN for crash reporting. Leave empty to keep Sentry disabled.
# Inlined into the JS bundle, so it can be turned on with an OTA update.
EXPO_PUBLIC_SENTRY_DSN=
